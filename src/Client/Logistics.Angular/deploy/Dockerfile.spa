# Shared image for the three nginx-served Angular SPAs.
# APP_NAME is the Angular project name: admin-portal | tms-portal | customer-portal.
#
# Stage 1: Build
FROM node:24-alpine AS builder
ARG PROJECT_DIR=src/Client/Logistics.Angular
ARG APP_NAME
WORKDIR /app

RUN npm install -g bun

# Manifests only, so the dependency layer caches across code changes.
COPY package.json bun.lock ./
COPY src/Client/Logistics.Angular/package.json src/Client/Logistics.Angular/
COPY src/Client/Logistics.DemoVideo/package.json src/Client/Logistics.DemoVideo/
RUN bun install --frozen-lockfile

COPY ${PROJECT_DIR}/ ${PROJECT_DIR}/
WORKDIR /app/${PROJECT_DIR}
# `ng` runs under npm, not bun: bun ships an older embedded Node than Angular 22 requires.
RUN bun run gen:api && npm run build:shared && npm run ng -- build ${APP_NAME}

# Stage 2: Runtime
FROM nginx:alpine
ARG PROJECT_DIR=src/Client/Logistics.Angular
ARG APP_NAME
COPY ${PROJECT_DIR}/deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/${PROJECT_DIR}/dist/${APP_NAME}/browser /usr/share/nginx/html
COPY ${PROJECT_DIR}/deploy/docker-entrypoint-spa.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
ENV MAPBOX_TOKEN=""
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
