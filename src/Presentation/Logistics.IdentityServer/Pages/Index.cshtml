@page
@model Logistics.IdentityServer.Pages.Home.Index

<div class="auth-centered">
    <div class="welcome-page">
        <img src="~/logo.svg" class="logo" alt="LogisticsX">
        <h1>LogisticsX</h1>
        <p class="text-muted">
            Sign in once here to reach the TMS, customer and admin portals.
        </p>

        @if (Model.IsSignedIn)
        {
            <a class="btn btn-primary" asp-page="/Account/Manage/Profile/Index">Manage your account</a>
        }
        else
        {
            <a class="btn btn-primary" asp-page="/Account/Login/Index">Sign in</a>
        }
    </div>
</div>
