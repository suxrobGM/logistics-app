{% assign Title = "Your data export is ready" %}
{% assign Preheader = "Sign in to download it before " | append: ExpiresAt | append: "." %}
<h1 class="h1 t-ink" style="margin: 0 0 16px; font-size: 24px; line-height: 1.3; font-weight: 700; color: #18181b;">Your data export is ready</h1>

<p class="t-body" style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #3f3f46;">Hi {{ UserName }},</p>

<p class="t-body" style="margin: 0; font-size: 16px; line-height: 1.6; color: #3f3f46;">
  The data export you asked for is ready. Sign in and open the privacy page to download it.
</p>

<table role="presentation" class="btn" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #18181b;">
      <a href="{{ PortalUrl }}" style="display: inline-block; padding: 14px 28px; font-size: 16px; line-height: 1.25; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px;">Open privacy page</a>
    </td>
  </tr>
</table>

<p class="t-body" style="margin: 0; font-size: 15px; line-height: 1.6; color: #3f3f46;">
  You can download it until <strong class="t-ink" style="color: #18181b;">{{ ExpiresAt }}</strong>. After that, request a new export whenever you need one.
  We leave the download link out of this email to keep your data safe.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">Didn't request this export? Contact support right away.</p>
    </td>
  </tr>
</table>
