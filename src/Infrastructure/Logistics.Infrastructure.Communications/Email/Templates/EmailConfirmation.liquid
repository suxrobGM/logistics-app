{% assign Title = "Confirm your email" %}
{% assign Preheader = "One quick step to finish setting up your account." %}
<h1 class="h1 t-ink" style="margin: 0 0 16px; font-size: 24px; line-height: 1.3; font-weight: 700; color: #18181b;">Confirm your email</h1>

<p class="t-body" style="margin: 0; font-size: 16px; line-height: 1.6; color: #3f3f46;">
  Thanks for signing up. Confirm this is your email address and your account is ready to go.
</p>

<table role="presentation" class="btn" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #18181b;">
      <a href="{{ ConfirmUrl }}" style="display: inline-block; padding: 14px 28px; font-size: 16px; line-height: 1.25; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px;">Confirm email</a>
    </td>
  </tr>
</table>

<p class="t-body" style="margin: 0; font-size: 15px; line-height: 1.6; color: #3f3f46;">
  Didn't create an account? You can ignore this email.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0 0 6px; font-size: 13px; line-height: 1.5; color: #71717a;">Button not working? Paste this link into your browser:</p>
      <p class="t-muted url" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a; word-break: break-all;"><a href="{{ ConfirmUrl }}" style="color: #71717a; text-decoration: underline;">{{ ConfirmUrl }}</a></p>
    </td>
  </tr>
</table>
