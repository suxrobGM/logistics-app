{% assign Title = "Track load #" | append: LoadNumber %}
{% assign Sender = CompanyName %}
{% assign Preheader = "Follow load #" | append: LoadNumber | append: " from " | append: OriginCity | append: " to " | append: DestinationCity | append: "." %}
<h1 class="h1 t-ink" style="margin: 0 0 16px; font-size: 24px; line-height: 1.3; font-weight: 700; color: #18181b;">Track your shipment</h1>

<p class="t-body" style="margin: 0; font-size: 16px; line-height: 1.6; color: #3f3f46;">
  {{ CompanyName }} shared a live tracking link for your shipment.
</p>

{% if PersonalMessage %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0;">
  <tr>
    <td class="c-rule" style="border-left: 3px solid #d4d4d8; padding: 2px 0 2px 16px;">
      <p class="t-muted" style="margin: 0 0 4px; font-size: 13px; line-height: 1.5; color: #71717a;">{{ CompanyName }} wrote:</p>
      <p class="t-body" style="margin: 0; font-size: 15px; line-height: 1.6; color: #3f3f46; white-space: pre-wrap;">{{ PersonalMessage }}</p>
    </td>
  </tr>
</table>
{% endif %}

<table role="presentation" class="c-panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0; background-color: #f4f4f5; border-radius: 8px;">
  <tr>
    <td class="panel-cell" style="padding: 20px;">
      <p class="t-muted" style="margin: 0 0 4px; font-size: 13px; line-height: 1.5; color: #71717a;">Load #{{ LoadNumber }}{% if LoadName %} &middot; {{ LoadName }}{% endif %}</p>
      <p class="t-ink" style="margin: 0; font-size: 17px; line-height: 1.5; font-weight: 600; color: #18181b;">{{ OriginCity }} &rarr; {{ DestinationCity }}</p>
    </td>
  </tr>
</table>

<table role="presentation" class="btn" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #18181b;">
      <a href="{{ TrackingUrl }}" style="display: inline-block; padding: 14px 28px; font-size: 16px; line-height: 1.25; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px;">Track shipment</a>
    </td>
  </tr>
</table>

<p class="t-body" style="margin: 0; font-size: 15px; line-height: 1.6; color: #3f3f46;">
  This link works until {{ ExpiresAt }}.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">
        The link only lets you view shipment status and documents. Not expecting this? You can ignore it.
      </p>
    </td>
  </tr>
</table>
