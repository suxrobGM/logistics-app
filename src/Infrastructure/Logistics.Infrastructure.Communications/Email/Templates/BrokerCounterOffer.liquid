{% assign Title = "Rate offer " | append: ReferenceNumber %}
{% assign Sender = CompanyName %}
{% assign Preheader = OfferTotal | append: " for " | append: OriginCity | append: ", " | append: OriginState | append: " to " | append: DestinationCity | append: ", " | append: DestinationState | append: "." %}
<p class="t-body" style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #3f3f46;">{% if BrokerName %}Hi {{ BrokerName }},{% else %}Hello,{% endif %}</p>

<p class="t-body" style="margin: 0; font-size: 16px; line-height: 1.6; color: #3f3f46; white-space: pre-wrap;">{{ Message }}</p>

<table role="presentation" class="c-panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0; background-color: #f4f4f5; border-radius: 8px;">
  <tr>
    <td class="panel-cell" style="padding: 20px;">
      <p class="t-muted" style="margin: 0 0 4px; font-size: 13px; line-height: 1.5; color: #71717a;">{% if ReferenceNumber %}Ref {{ ReferenceNumber }}{% else %}Load{% endif %}</p>
      <p class="t-ink" style="margin: 0 0 12px; font-size: 17px; line-height: 1.5; font-weight: 600; color: #18181b;">{{ OriginCity }}, {{ OriginState }} &rarr; {{ DestinationCity }}, {{ DestinationState }}</p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Pickup</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">{{ PickupDate }}</td>
        </tr>
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Equipment</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">{{ EquipmentType }}</td>
        </tr>
        <tr>
          <td class="t-ink c-rule" style="padding: 12px 12px 0 0; border-top: 1px solid #e4e4e7; font-size: 15px; line-height: 1.5; font-weight: 600; color: #18181b; vertical-align: middle;">Our offer</td>
          <td class="t-ink c-rule" align="right" style="padding: 12px 0 0; border-top: 1px solid #e4e4e7; font-size: 20px; line-height: 1.3; font-weight: 700; color: #18181b; text-align: right; vertical-align: middle; white-space: nowrap;">
            {{ OfferTotal }}{% if OfferPerMile %}<br><span class="t-muted" style="font-size: 13px; font-weight: 500; color: #71717a;">{{ OfferPerMile }}/mi</span>{% endif %}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p class="t-body" style="margin: 24px 0 0; font-size: 16px; line-height: 1.6; color: #3f3f46;">
  {{ CompanyName }}{% if CompanyMcNumber %}<br><span class="t-muted" style="font-size: 14px; color: #71717a;">MC# {{ CompanyMcNumber }}</span>{% endif %}
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">{{ ReplyInstructions }}</p>
    </td>
  </tr>
</table>
