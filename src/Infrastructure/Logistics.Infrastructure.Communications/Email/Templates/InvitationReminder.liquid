{% assign Title = "Reminder: join " | append: CompanyName %}
{% assign Sender = CompanyName %}
{% assign Preheader = "Your invitation to " | append: CompanyName | append: " expires " | append: ExpiresAt | append: "." %}
<h1 class="h1 t-ink" style="margin: 0 0 16px; font-size: 24px; line-height: 1.3; font-weight: 700; color: #18181b;">Your invitation is still waiting</h1>

<p class="t-body" style="margin: 0; font-size: 16px; line-height: 1.6; color: #3f3f46;">
  Just a reminder: {{ InvitedByName }} invited you to join {{ CompanyName }} as a {{ TypeLabel }}.
</p>

<table role="presentation" class="c-panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0; background-color: #f4f4f5; border-radius: 8px;">
  <tr>
    <td class="panel-cell" style="padding: 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Role</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">{{ RoleDisplayName }}</td>
        </tr>
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Expires</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">{{ ExpiresAt }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<table role="presentation" class="btn" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0 0;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #18181b;">
      <a href="{{ AcceptUrl }}" style="display: inline-block; padding: 14px 28px; font-size: 16px; line-height: 1.25; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px;">Accept invitation</a>
    </td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0 0 6px; font-size: 13px; line-height: 1.5; color: #71717a;">Not expecting this? You can ignore it. Button not working? Paste this link into your browser:</p>
      <p class="t-muted url" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a; word-break: break-all;"><a href="{{ AcceptUrl }}" style="color: #71717a; text-decoration: underline;">{{ AcceptUrl }}</a></p>
    </td>
  </tr>
</table>
