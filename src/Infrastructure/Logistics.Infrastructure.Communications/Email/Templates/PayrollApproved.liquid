{% assign Title = "Payroll #" | append: PayrollNumber | append: " approved" %}
{% assign Preheader = TotalAmount | append: " for " | append: PeriodStart | append: " - " | append: PeriodEnd | append: " is on its way." %}
<p style="margin: 0 0 16px;"><span style="display: inline-block; padding: 4px 10px; border-radius: 999px; background-color: #dcfce7; color: #166534; font-size: 12px; line-height: 1.4; font-weight: 600;">Approved</span></p>

<h1 class="h1 t-ink" style="margin: 0 0 16px; font-size: 24px; line-height: 1.3; font-weight: 700; color: #18181b;">Your payroll was approved</h1>

<p class="t-body" style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #3f3f46;">Hi {{ EmployeeName }},</p>

<p class="t-body" style="margin: 0; font-size: 16px; line-height: 1.6; color: #3f3f46;">
  Good news: your payroll was approved and is now being processed for payment.
</p>

<table role="presentation" class="c-panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0; background-color: #f4f4f5; border-radius: 8px;">
  <tr>
    <td class="panel-cell" style="padding: 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Payroll</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">#{{ PayrollNumber }}</td>
        </tr>
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Pay period</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">{{ PeriodStart }} &ndash; {{ PeriodEnd }}</td>
        </tr>
        <tr>
          <td class="t-ink c-rule" style="padding: 12px 12px 0 0; border-top: 1px solid #e4e4e7; font-size: 15px; line-height: 1.5; font-weight: 600; color: #18181b; vertical-align: middle;">Total earnings</td>
          <td class="t-ink c-rule" align="right" style="padding: 12px 0 0; border-top: 1px solid #e4e4e7; font-size: 20px; line-height: 1.3; font-weight: 700; color: #18181b; text-align: right; vertical-align: middle;">{{ TotalAmount }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p class="t-body" style="margin: 24px 0 0; font-size: 15px; line-height: 1.6; color: #3f3f46;">
  You'll be paid on your company's regular pay schedule. Questions? Ask your manager or HR.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">This is an automated message, so replies aren't monitored.</p>
    </td>
  </tr>
</table>
