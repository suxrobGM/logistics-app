{% assign Title = Heading %}
{% assign Preheader = Heading | append: " from the website." %}
<h1 class="h1 t-ink" style="margin: 0 0 20px; font-size: 24px; line-height: 1.3; font-weight: 700; color: #18181b;">{{ Heading }}</h1>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  {% for field in Fields %}
  <tr>
    <td class="c-rule" style="padding: 10px 0; border-bottom: 1px solid #e4e4e7;">
      <p class="t-muted" style="margin: 0 0 2px; font-size: 13px; line-height: 1.5; color: #71717a;">{{ field.Label }}</p>
      <p class="t-ink url" style="margin: 0; font-size: 15px; line-height: 1.5; color: #18181b; word-break: break-word;">{{ field.Value }}</p>
    </td>
  </tr>
  {% endfor %}
</table>

{% if Message %}
<table role="presentation" class="c-panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0; background-color: #f4f4f5; border-radius: 8px;">
  <tr>
    <td class="panel-cell" style="padding: 20px;">
      <p class="t-body" style="margin: 0; font-size: 15px; line-height: 1.6; color: #3f3f46; white-space: pre-wrap;">{{ Message }}</p>
    </td>
  </tr>
</table>
{% endif %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">Reply to this email to answer the sender. The lead is also listed in the admin portal.</p>
    </td>
  </tr>
</table>
