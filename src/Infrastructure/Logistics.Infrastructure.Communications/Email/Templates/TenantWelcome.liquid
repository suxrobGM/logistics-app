{% assign Title = "Welcome to LogisticsX" %}
{% assign Preheader = CompanyName | append: " is set up and ready. Here's how to sign in." %}
<h1 class="h1 t-ink" style="margin: 0 0 16px; font-size: 24px; line-height: 1.3; font-weight: 700; color: #18181b;">Welcome to LogisticsX</h1>

<p class="t-body" style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #3f3f46;">Hi {{ OwnerName }},</p>

<p class="t-body" style="margin: 0; font-size: 16px; line-height: 1.6; color: #3f3f46;">
  {{ CompanyName }} is set up and ready to go.
  {% if TemporaryPassword %}Here's how to sign in for the first time.{% else %}Sign in with the account you already have.{% endif %}
</p>

{% if TemporaryPassword %}
<table role="presentation" class="c-panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0; background-color: #f4f4f5; border-radius: 8px;">
  <tr>
    <td class="panel-cell" style="padding: 20px;">
      <p class="t-muted" style="margin: 0 0 4px; font-size: 13px; line-height: 1.5; color: #71717a;">Email</p>
      <p class="t-ink url" style="margin: 0 0 16px; font-size: 15px; line-height: 1.5; font-weight: 600; color: #18181b; word-break: break-all;">{{ Email }}</p>
      <p class="t-muted" style="margin: 0 0 4px; font-size: 13px; line-height: 1.5; color: #71717a;">Temporary password</p>
      <p class="t-ink url" style="margin: 0; font-size: 15px; line-height: 1.5; font-weight: 600; color: #18181b; font-family: 'SFMono-Regular', Menlo, Consolas, monospace; word-break: break-all;">{{ TemporaryPassword }}</p>
    </td>
  </tr>
</table>

<p class="t-body" style="margin: 16px 0 0; font-size: 15px; line-height: 1.6; color: #3f3f46;">
  Change this password after you sign in for the first time.
</p>
{% endif %}

<table role="presentation" class="btn" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0 0;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #18181b;">
      <a href="{{ LoginUrl }}" style="display: inline-block; padding: 14px 28px; font-size: 16px; line-height: 1.25; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px;">Sign in</a>
    </td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">Not expecting this email? Contact support.</p>
    </td>
  </tr>
</table>
