{% if IsFullyPaid %}
{% assign Title = "Payroll #" | append: PayrollNumber | append: " paid in full" %}
{% assign Preheader = "You've been paid " | append: PaymentAmount | append: ". Your payroll is paid in full." %}
{% else %}
{% assign Title = "Payment on payroll #" | append: PayrollNumber %}
{% assign Preheader = "You've been paid " | append: PaymentAmount | append: ". " | append: OutstandingAmount | append: " is still outstanding." %}
{% endif %}
<p style="margin: 0 0 16px;">
  {% if IsFullyPaid %}
  <span style="display: inline-block; padding: 4px 10px; border-radius: 999px; background-color: #dcfce7; color: #166534; font-size: 12px; line-height: 1.4; font-weight: 600;">Paid in full</span>
  {% else %}
  <span style="display: inline-block; padding: 4px 10px; border-radius: 999px; background-color: #fef3c7; color: #92400e; font-size: 12px; line-height: 1.4; font-weight: 600;">Partially paid</span>
  {% endif %}
</p>

<h1 class="h1 t-ink" style="margin: 0 0 16px; font-size: 24px; line-height: 1.3; font-weight: 700; color: #18181b;">{% if IsFullyPaid %}Your payroll is paid in full{% else %}You received a payment{% endif %}</h1>

<p class="t-body" style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #3f3f46;">Hi {{ EmployeeName }},</p>

<p class="t-body" style="margin: 0; font-size: 16px; line-height: 1.6; color: #3f3f46;">
  {% if IsFullyPaid %}
  Your payroll is paid in full. The money should reach your account within your payment method's usual processing time.
  {% else %}
  A payment was recorded on your payroll. The details are below.
  {% endif %}
</p>

<table role="presentation" class="c-panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0; background-color: #f4f4f5; border-radius: 8px;">
  <tr>
    <td class="panel-cell" style="padding: 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Payroll</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">#{{ PayrollNumber }}</td>
        </tr>
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Pay period</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">{{ PeriodStart }} &ndash; {{ PeriodEnd }}</td>
        </tr>
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Total earnings</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">{{ TotalAmount }}</td>
        </tr>
        {% unless IsFullyPaid %}
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Still outstanding</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">{{ OutstandingAmount }}</td>
        </tr>
        {% endunless %}
        <tr>
          <td class="t-ink c-rule" style="padding: 12px 12px 0 0; border-top: 1px solid #e4e4e7; font-size: 15px; line-height: 1.5; font-weight: 600; color: #18181b; vertical-align: middle;">This payment</td>
          <td class="t-ink c-rule" align="right" style="padding: 12px 0 0; border-top: 1px solid #e4e4e7; font-size: 20px; line-height: 1.3; font-weight: 700; color: #18181b; text-align: right; vertical-align: middle;">{{ PaymentAmount }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p class="t-body" style="margin: 24px 0 0; font-size: 15px; line-height: 1.6; color: #3f3f46;">
  Questions about this payment? Ask your manager or HR.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">This is an automated message, so replies aren't monitored.</p>
    </td>
  </tr>
</table>
