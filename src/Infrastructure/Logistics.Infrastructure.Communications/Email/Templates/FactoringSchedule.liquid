{% assign Title = "Schedule of accounts #" | append: ScheduleNumber %}
{% assign Sender = CompanyName %}
{% assign Preheader = CompanyName | append: " submits " | append: Total | append: " in invoices for purchase." %}
<p class="t-muted" style="margin: 0 0 4px; font-size: 14px; line-height: 1.5; color: #71717a;">Schedule of accounts #{{ ScheduleNumber }}</p>
<h1 class="h1 t-ink" style="margin: 0 0 16px; font-size: 24px; line-height: 1.3; font-weight: 700; color: #18181b;">{{ Invoices.size }} {% if Invoices.size == 1 %}invoice{% else %}invoices{% endif %} for purchase</h1>

<p class="t-body" style="margin: 0; font-size: 16px; line-height: 1.6; color: #3f3f46;">
  {{ CompanyName }} submits the invoices below to {{ FactorName }} for purchase.
  The schedule, each invoice and its delivery paperwork (POD/BOL, rate confirmation) are attached.
</p>

{% if Notes %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0;">
  <tr>
    <td class="c-rule" style="border-left: 3px solid #d4d4d8; padding: 2px 0 2px 16px;">
      <p class="t-muted" style="margin: 0 0 4px; font-size: 13px; line-height: 1.5; color: #71717a;">Notes</p>
      <p class="t-body" style="margin: 0; font-size: 15px; line-height: 1.6; color: #3f3f46; white-space: pre-wrap;">{{ Notes }}</p>
    </td>
  </tr>
</table>
{% endif %}

<table role="presentation" class="c-panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0; background-color: #f4f4f5; border-radius: 8px;">
  <tr>
    <td class="panel-cell" style="padding: 8px 20px 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        {% for invoice in Invoices %}
        <tr>
          <td class="c-rule" style="padding: 12px 12px 12px 0;{% unless forloop.first %} border-top: 1px solid #e4e4e7;{% endunless %} vertical-align: top;">
            <p class="t-ink" style="margin: 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b;">Invoice #{{ invoice.InvoiceNumber }}</p>
            <p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">Load #{{ invoice.LoadNumber }} &middot; {{ invoice.CustomerName }}</p>
          </td>
          <td class="t-ink c-rule" align="right" style="padding: 12px 0;{% unless forloop.first %} border-top: 1px solid #e4e4e7;{% endunless %} font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top; white-space: nowrap;">{{ invoice.Amount }}</td>
        </tr>
        {% endfor %}
        <tr>
          <td class="t-ink c-rule" style="padding: 12px 12px 0 0; border-top: 1px solid #a1a1aa; font-size: 15px; line-height: 1.5; font-weight: 600; color: #18181b; vertical-align: middle;">Total</td>
          <td class="t-ink c-rule" align="right" style="padding: 12px 0 0; border-top: 1px solid #a1a1aa; font-size: 20px; line-height: 1.3; font-weight: 700; color: #18181b; text-align: right; vertical-align: middle; white-space: nowrap;">{{ Total }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{% if ReplyEmail %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">Send funding details or questions by replying to this email, or write to <a href="mailto:{{ ReplyEmail }}" style="color: #71717a; text-decoration: underline;">{{ ReplyEmail }}</a>.</p>
    </td>
  </tr>
</table>
{% endif %}
