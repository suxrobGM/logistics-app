{% assign Title = "Invoice #" | append: InvoiceNumber | append: " from " | append: CompanyName %}
{% assign Sender = CompanyName %}
{% if DueDate %}
{% assign Preheader = AmountDue | append: " due " | append: DueDate | append: "." %}
{% else %}
{% assign Preheader = AmountDue | append: " due." %}
{% endif %}
<p class="t-muted" style="margin: 0 0 4px; font-size: 14px; line-height: 1.5; color: #71717a;">Invoice #{{ InvoiceNumber }}</p>
<p class="t-ink" style="margin: 0 0 4px; font-size: 32px; line-height: 1.2; font-weight: 700; letter-spacing: -0.02em; color: #18181b;">{{ AmountDue }}</p>
<p class="t-body" style="margin: 0; font-size: 15px; line-height: 1.6; color: #3f3f46;">{% if DueDate %}Due {{ DueDate }}{% else %}Amount due{% endif %}</p>

<p class="t-body" style="margin: 24px 0 0; font-size: 16px; line-height: 1.6; color: #3f3f46;">
  {{ CompanyName }} sent you an invoice{% if LoadNumber %} for load #{{ LoadNumber }}{% endif %}.
</p>

{% if PersonalMessage %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0;">
  <tr>
    <td class="c-rule" style="border-left: 3px solid #d4d4d8; padding: 2px 0 2px 16px;">
      <p class="t-muted" style="margin: 0 0 4px; font-size: 13px; line-height: 1.5; color: #71717a;">{{ CompanyName }} wrote:</p>
      <p class="t-body" style="margin: 0; font-size: 15px; line-height: 1.6; color: #3f3f46; white-space: pre-wrap;">{{ PersonalMessage }}</p>
    </td>
  </tr>
</table>
{% endif %}

{% unless RemitToName %}
<table role="presentation" class="btn" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0 0;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #18181b;">
      <a href="{{ PaymentUrl }}" style="display: inline-block; padding: 14px 28px; font-size: 16px; line-height: 1.25; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px;">Pay invoice</a>
    </td>
  </tr>
</table>
{% if ExpiresAt %}
<p class="t-muted" style="margin: 12px 0 0; font-size: 13px; line-height: 1.5; color: #71717a;">The payment link works until {{ ExpiresAt }}.</p>
{% endif %}
{% endunless %}

<table role="presentation" class="c-panel" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0 0; background-color: #f4f4f5; border-radius: 8px;">
  <tr>
    <td class="panel-cell" style="padding: 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        {% if CustomerName %}
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Billed to</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">{{ CustomerName }}</td>
        </tr>
        {% endif %}
        {% if LoadNumber %}
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Load</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">#{{ LoadNumber }}</td>
        </tr>
        {% endif %}
        {% if DueDate %}
        <tr>
          <td class="t-muted" style="padding: 4px 12px 4px 0; font-size: 14px; line-height: 1.5; color: #71717a; vertical-align: top;">Due date</td>
          <td class="t-ink" align="right" style="padding: 4px 0; font-size: 14px; line-height: 1.5; font-weight: 600; color: #18181b; text-align: right; vertical-align: top;">{{ DueDate }}</td>
        </tr>
        {% endif %}
        {% for item in LineItems %}
        <tr>
          <td class="c-rule" style="padding: 10px 12px 10px 0;{% if forloop.first %} border-top: 1px solid #e4e4e7;{% endif %} vertical-align: top;">
            <p class="t-ink" style="margin: 0; font-size: 14px; line-height: 1.5; color: #18181b;">{{ item.Description }}</p>
            {% if item.Quantity > 1 %}<p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">{{ item.Quantity }} &times; {{ item.Amount }}</p>{% endif %}
          </td>
          <td class="t-ink c-rule" align="right" style="padding: 10px 0;{% if forloop.first %} border-top: 1px solid #e4e4e7;{% endif %} font-size: 14px; line-height: 1.5; color: #18181b; text-align: right; vertical-align: top; white-space: nowrap;">{{ item.Total }}</td>
        </tr>
        {% endfor %}
        <tr>
          <td class="t-muted c-rule" style="padding: 12px 12px 4px 0; border-top: 1px solid #e4e4e7; font-size: 14px; line-height: 1.5; color: #71717a;">Total</td>
          <td class="t-ink c-rule" align="right" style="padding: 12px 0 4px; border-top: 1px solid #e4e4e7; font-size: 14px; line-height: 1.5; color: #18181b; text-align: right; white-space: nowrap;">{{ Total }}</td>
        </tr>
        <tr>
          <td class="t-ink" style="padding: 4px 12px 0 0; font-size: 15px; line-height: 1.5; font-weight: 600; color: #18181b; vertical-align: middle;">Amount due</td>
          <td class="t-ink" align="right" style="padding: 4px 0 0; font-size: 20px; line-height: 1.3; font-weight: 700; color: #18181b; text-align: right; vertical-align: middle; white-space: nowrap;">{{ AmountDue }}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{% if RemitToName %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 0;">
  <tr>
    <td class="c-rule" style="padding: 16px; border: 1px solid #18181b; border-radius: 8px;">
      <p class="t-ink" style="margin: 0 0 6px; font-size: 14px; line-height: 1.5; font-weight: 700; color: #18181b;">Notice of assignment</p>
      <p class="t-body" style="margin: 0; font-size: 14px; line-height: 1.6; color: #3f3f46;">
        This invoice has been assigned to and must be paid only to <strong class="t-ink" style="color: #18181b;">{{ RemitToName }}</strong>{% if RemitToAddress %}, {{ RemitToAddress }}{% endif %}.
        Payment to anyone else does not discharge the debt.
      </p>
    </td>
  </tr>
</table>
{% endif %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 32px;">
  <tr>
    <td class="c-rule" style="border-top: 1px solid #e4e4e7; padding-top: 20px;">
      <p class="t-muted" style="margin: 0; font-size: 13px; line-height: 1.5; color: #71717a;">Questions about this invoice? Contact {{ CompanyName }} directly.</p>
    </td>
  </tr>
</table>
