{
  "editor.tabSize": 2,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit",
    "source.fixAll.biome": "explicit"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.angular": true,
    "**/bin": true,
    "**/obj": true,
    "**/.gradle": true,
    "**/.idea": true,
    "**/.kotlin": true,
    "**/.vs": true,
    "**/dist": true,
    "**/out-tsc": true
  },
  "VSCodeCounter.exclude": [
    "bun.lock",
    "openapi.json",
    "src/Infrastructure/Logistics.Infrastructure.Persistence/Migrations"
  ],
  "VSCodeCounter.languages": {
    "kotlin": {
      "aliases": ["Kotlin"],
      "filenames": [],
      "extensions": [".kt", ".kts"],
      "lineComments": ["//"],
      "blockComments": [["/*", "*/"]],
      "blockStrings": [["\"\"\"", "\"\"\""]]
    }
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
