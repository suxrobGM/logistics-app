{
  "mcpServers": {
    "logisticsx": {
      "type": "http",
      "url": "http://localhost:7000/mcp",
      "headers": {
        "Authorization": "Bearer <your-api-key>"
      },
      "note": "Replace <your-api-key> with an API key from TMS Portal > Settings > API Keys"
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp/logisticsx"
    },
    "mobile-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mobilenext/mobile-mcp@latest"],
      "env": {}
    }
  }
}
